pipeline {
    agent any

    environment {
        DB_CREDS = credentials('jenkins-sql-creds')
        DB_NAME = 'jenkinsTesting'
        MSSQL_CONNECTION_STRING = "Server=localhost\\SQLEXPRESS;Database=${DB_NAME};User Id=${DB_CREDS_USR};Password=${DB_CREDS_PSW};TrustServerCertificate=True;"
    }

    parameters {
        booleanParam(name: 'DEPLOY_TO_PROD', defaultValue: false, description: 'Deploy to production environment?')
        string(name: 'PrintingDifferentValue', defaultValue: 'test', description: 'Print the Default value')
        string(name: 'GitLink', defaultValue: '', description: 'Enter the raw Git URL to the SQL script (e.g., https://raw.githubusercontent.com/.../queries.sql)')
        string(name: 'SQL_FILE_NAME', defaultValue: '', description: 'Enter the SQL file name (e.g., queries.sql)')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/HarrishC/jenkins_pipepline_testing.git'
            }
        }
        stage('Build') {
            steps {
                echo "Build number : ${BUILD_NUMBER}"
            }
        }
        stage('Deploy') {
            steps {
                script {
                    if (params.DEPLOY_TO_PROD == true) {
                        echo 'Hello World!'
                        // Add your deployment commands here
                    } else {
                        error('Deploy to production is set to false. Failing the pipeline.')
                    }
                    if (params.PrintingDifferentValue == '') {
                        error('PrintingDifferentValue is empty. This is not allowed.')
                    } else {
                        echo params.PrintingDifferentValue
                    }
                }
            }
        }
        stage('Approval') {
            steps {
                script {
                    def userInput = input(
                        id: 'DeployInput',
                        message: 'Do you want to proceed with the manual deployment?',
                        ok: 'Proceed',
                        cancel: 'Abort',
                        parameters: [
                            string(name: 'APPROVAL_REASON', defaultValue: '', description: 'Please provide(Y/N)')
                        ]
                    )
                    
                    // The crucial validation logic that was missing!
                    if (userInput == 'N') {
                        error("Approval reason is ${userInput}. Ending the pipeline.")
                    } else if (userInput == 'Y') {
                        echo "Approval reason is ${userInput}. Proceeding with the pipeline."
                        echo 'https://harrishc.github.io/html-video-background/'
                    } else {
                        error("Approval reason is not Yes or No. Ending the pipeline.")
                    }
                }
            }
        }
        stage('Check DB Connection') {
            steps {
                script {
                    echo "Checking connection to SQL Server..."

                    // Step 1: Verify DB connectivity
                    def checkDbCommand = """@echo off
                        sqlcmd -S localhost\\SQLEXPRESS -d jenkinsTesting -U %DB_CREDS_USR% -P %DB_CREDS_PSW% > nul 2>&1
                    """
                    def result = bat(script: checkDbCommand, returnStatus: true)
                    if (result == 0) {
                        echo "Successfully connected to the database: ${DB_NAME}"
                    } else {
                        error("Failed to connect to the database. Check connection string and server status.")
                    }

                    // Step 2: Execute the SQL file specified via SQL_FILE_NAME from the GitHub repo
                    if (!params.SQL_FILE_NAME?.trim()) {
                        error("SQL_FILE_NAME parameter is empty. Please specify the SQL file name (e.g., queries.sql).")
                    }
                    if (!params.GitLink?.trim()) {
                        error("GitLink parameter is empty. Please provide the GitHub folder URL (e.g., https://github.com/user/repo/tree/main/sql/).")
                    }

                    dir('queries') {
                        withCredentials([usernamePassword(credentialsId: 'jenkins-github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                            def fileName = params.SQL_FILE_NAME.trim()
                            def gitLink  = params.GitLink.trim().replaceAll('/$', '')

                            def psClone = """
                                \$ProgressPreference = 'SilentlyContinue'
                                \$ErrorActionPreference = 'Stop'

                                # ── Parse GitHub folder URL ───────────────────────────────────────
                                # Input:  https://github.com/{owner}/{repo}/tree/{branch}/{folder}
                                \$stripped = '${gitLink}' -replace '^https://github\\.com/', ''
                                \$parts    = \$stripped -split '/'
                                \$owner    = \$parts[0]
                                \$repo     = \$parts[1]
                                \$treeIdx  = [Array]::IndexOf(\$parts, 'tree')
                                if (\$treeIdx -lt 0) { \$treeIdx = [Array]::IndexOf(\$parts, 'blob') }

                                if (\$treeIdx -ge 0) {
                                    \$branch = \$parts[\$treeIdx + 1]
                                    \$folder = (\$parts[(\$treeIdx + 2)..(\$parts.Length - 1)] -join '/').TrimEnd('/')
                                } else {
                                    \$branch = 'main'
                                    \$folder = ''
                                }

                                \$filePath = if (\$folder) { "\$folder/${fileName}" } else { '${fileName}' }
                                \$cloneUrl = "https://\$env:GIT_USER:\$env:GIT_PASS@github.com/\$owner/\$repo.git"

                                Write-Host "Repo   : \$owner/\$repo"
                                Write-Host "Branch : \$branch"
                                Write-Host "File   : \$filePath"

                                # ── Shallow clone and extract the SQL file ────────────────────────
                                # git clone uses the same credential as the Checkout stage — always works.
                                if (Test-Path 'sql_clone') { Remove-Item -Recurse -Force 'sql_clone' }

                                git clone --depth 1 --branch \$branch \$cloneUrl sql_clone
                                if (\$LASTEXITCODE -ne 0) {
                                    Write-Error "git clone failed. Check the GitLink URL and credentials."
                                    exit 1
                                }

                                \$src = "sql_clone/\$filePath"
                                if (-not (Test-Path \$src)) {
                                    Write-Error "File not found in repo: \$filePath"
                                    exit 1
                                }

                                Copy-Item \$src -Destination 'query_to_run.sql' -Force
                                Remove-Item -Recurse -Force 'sql_clone'
                                Write-Host "Ready: query_to_run.sql (\$((Get-Item 'query_to_run.sql').Length) bytes)"
                            """
                            def cloneResult = powershell(script: psClone, returnStatus: true)
                            if (cloneResult != 0) {
                                error("Failed to retrieve '${params.SQL_FILE_NAME}' from GitHub. Check the GitLink URL format and file path.")
                            }
                        }le name is correct, (3) jenkins-github-creds PAT has 'repo' scope.")
                            }
                        }

                        // Guard: fail immediately if GitHub returned HTML instead of SQL
                        def content = readFile('query_to_run.sql')
                        if (content.toLowerCase().contains('<!doctype html') || content.toLowerCase().contains('<html')) {
                            error("GitHub returned an HTML page instead of '${params.SQL_FILE_NAME}'. Check the jenkins-github-creds credential type (must be Username+Password) and PAT scope.")
                        }

                        echo "SQL file '${params.SQL_FILE_NAME}' ready. Executing against ${DB_NAME}..."

                        def dbCommand = """@echo off
                            sqlcmd -S localhost\\SQLEXPRESS -d ${DB_NAME} -U %DB_CREDS_USR% -P %DB_CREDS_PSW% -i "query_to_run.sql"
                        """
                        def executeResult = bat(script: dbCommand, returnStatus: true)
                        if (executeResult == 0) {
                            echo "Successfully executed '${params.SQL_FILE_NAME}'."
                        } else {
                            error("Failed to execute '${params.SQL_FILE_NAME}'. Check the SQL syntax and database connection.")
                        }
                    }
                }
            }
        }
        stage('Clean Workspace'){
            steps{
                cleanWs()
            }
        }
    }
    post {
        always {
            emailext(
                to: 'harrishgamer13@gmail.com',
                subject: "${currentBuild.result} - ${currentBuild.fullDisplayName}",
                body: "Build completed Successfully for Build #${currentBuild.number} - ${currentBuild.result}\n${env.BUILD_URL}. Please find the logs attached.",
                attachLog: true,
                recipientProviders: [
                    [$class: 'RequesterRecipientProvider']
                ] 
            )
        }
    }
}