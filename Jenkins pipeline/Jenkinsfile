pipeline {
    agent any

    environment {
        DB_CREDS = credentials('jenkins-sql-creds')
        MSSQL_CONNECTION_STRING = "Server=localhost\\SQLEXPRESS;Database=jenkinsTesting;User Id=${DB_CREDS_USR};Password=${DB_CREDS_PSW};TrustServerCertificate=True;"
    }

    parameters {
        booleanParam(name: 'DEPLOY_TO_PROD', defaultValue: false, description: 'Deploy to production environment?')
        string(name: 'PrintingDifferentValue', defaultValue: 'test', description: 'Print the Default value')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/HarrishC/jenkins_pipepline_testing.git'
            }
        }
        stage('Build') {
            steps {
                echo "Build number : ${BUILD_NUMBER}"
            }
        }
        stage('Deploy') {
            steps {
                script {
                    if (params.DEPLOY_TO_PROD == true) {
                        echo 'Hello World!'
                        // Add your deployment commands here
                    } else {
                        error('Deploy to production is set to false. Failing the pipeline.')
                    }
                    if (params.PrintingDifferentValue == '') {
                        error('PrintingDifferentValue is empty. This is not allowed.')
                    } else {
                        echo params.PrintingDifferentValue
                    }
                }
            }
        }
        stage('Approval') {
            steps {
                script {
                    def userInput = input(
                        id: 'DeployInput',
                        message: 'Do you want to proceed with the manual deployment?',
                        ok: 'Proceed',
                        cancel: 'Abort',
                        parameters: [
                            string(name: 'APPROVAL_REASON', defaultValue: '', description: 'Please provide(Y/N)')
                        ]
                    )
                    
                    // The crucial validation logic that was missing!
                    if (userInput == 'N') {
                        error("Approval reason is ${userInput}. Ending the pipeline.")
                    } else if (userInput == 'Y') {
                        echo "Approval reason is ${userInput}. Proceeding with the pipeline."
                        echo 'https://harrishc.github.io/html-video-background/'
                    } else {
                        error("Approval reason is not Yes or No. Ending the pipeline.")
                    }
                }
            }
        }
        stage('Check DB Connection') {
            steps {
                script {
                    echo "Checking connection to SQL Server..."
                    // The command now reads from queries.sql using its absolute path via %WORKSPACE%
                    // Read the SQL script contents and print them to the Jenkins console
                    
                    def checkDbCommand = """@echo off
                        sqlcmd -S localhost\\SQLEXPRESS -d jenkinsTesting -U %DB_CREDS_USR% -P %DB_CREDS_PSW%"
                    """
                    
                    def result = bat(script: checkDbCommand, returnStatus: true)
                    
                    if (result == 0) {
                        echo "Successfully connected to the database."
                    } else {
                        error("Failed to connect to the database. Check connection string and server status.")
                    }

                    def sqlQuery = readFile('Jenkins pipeline\\queries.sql')
                    echo "Executing the following SQL query:\n${sqlQuery}"

                    def dbCommand = """@echo off
                        sqlcmd -S localhost\\SQLEXPRESS -d jenkinsTesting -U %DB_CREDS_USR% -P %DB_CREDS_PSW% -i "Jenkins pipeline\\queries.sql"
                    """

                    def executeQuery = bat(script: dbCommand, returnStatus: true)
                    
                    if (executeQuery == 0) {
                        echo "Successfully executed the SQL query."
                    } else {
                        error("Failed to execute the SQL query. Check the query and database connection.")
                    }
                }
            }
        }
        stage('Clean Workspace'){
            steps{
                cleanWs()
            }
        }
    }
    post {
        always {
            emailext(
                to: 'harrishgamer13@gmail.com',
                subject: "${currentBuild.result} - ${currentBuild.fullDisplayName}",
                body: "Build completed Successfully for Build #${currentBuild.number} - ${currentBuild.result}\n${env.BUILD_URL}. Please find the logs attached.",
                attachLog: true,
                recipientProviders: [
                    [$class: 'RequesterRecipientProvider']
                ] 
            )
        }
    }
}