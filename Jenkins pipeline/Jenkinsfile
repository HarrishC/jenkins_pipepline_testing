pipeline {
    agent any

    environment {
        // Will be populated dynamically in the Load Credentials stage to hide credentials
        MSSQL_CONNECTION_STRING = ''
    }

    parameters {
        booleanParam(name: 'DEPLOY_TO_PROD', defaultValue: false, description: 'Deploy to production environment?')
        string(name: 'PrintingDifferentValue', defaultValue: 'test', description: 'Print the Default value')
    }

    stages {
        stage('Load Credentials') {
            steps {
                script {
                    if (fileExists('db_creds.txt')) {
                        def creds = readFile('db_creds.txt').split('\r?\n')
                        env.DB_USER = creds[0].trim()
                        env.DB_PASS = creds[1].trim()
                        env.MSSQL_CONNECTION_STRING = "Server=localhost\\SQLEXPRESS;Database=jenkinsTesting;User Id=${env.DB_USER};Password=${env.DB_PASS};TrustServerCertificate=True;"
                        echo "Loaded credentials successfully."
                    } else {
                        error('Missing db_creds.txt file! Please create it with username on line 1 and password on line 2 in the workspace.')
                    }
                }
            }
        }
        stage('Build') {
            steps {
                echo "Build number : ${BUILD_NUMBER}"
            }
        }
        stage('Check DB Connection') {
            steps {
                script {
                    echo "Checking connection to SQL Server..."
                    
                    // The command uses Windows Authentication (-E) to connect to the server (-S)
                    // and database (-d) and runs a simple query (-Q) to check the connection.
                    // Here we use %DB_USER% and %DB_PASS% with @echo off to avoid leaking credentials in the console log
                    def checkDbCommand = """@echo off
                        sqlcmd -S localhost\\SQLEXPRESS -d jenkinsTesting -U %DB_USER% -P %DB_PASS% -Q "SELECT 1 as ConnectionStatus"
                    """
                    
                    def result = bat(script: checkDbCommand, returnStatus: true)
                    
                    if (result == 0) {
                        echo "Successfully connected to the database."
                    } else {
                        error("Failed to connect to the database. Check connection string and server status.")
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    if (params.DEPLOY_TO_PROD == true) {
                        echo 'Hello World!'
                        // Add your deployment commands here
                    } else {
                        error('Deploy to production is set to false. Failing the pipeline.')
                    }
                    if (params.PrintingDifferentValue == '') {
                        error('PrintingDifferentValue is empty. This is not allowed.')
                    } else {
                        echo params.PrintingDifferentValue
                    }
                }
            }
        }
        stage('Approval') {
            steps {
                script {
                    def userInput = input(
                        id: 'DeployInput',
                        message: 'Do you want to proceed with the manual deployment?',
                        ok: 'Proceed',
                        cancel: 'Abort',
                        parameters: [
                            string(name: 'APPROVAL_REASON', defaultValue: '', description: 'Please provide(Y/N)')
                        ]
                    )
                    
                    // The crucial validation logic that was missing!
                    if (userInput == 'N') {
                        error("Approval reason is ${userInput}. Ending the pipeline.")
                    } else if (userInput == 'Y') {
                        echo "Approval reason is ${userInput}. Proceeding with the pipeline."
                        echo 'https://harrishc.github.io/html-video-background/'
                    } else {
                        error("Approval reason is not Yes or No. Ending the pipeline.")
                    }
                }
            }
        }
    }
}