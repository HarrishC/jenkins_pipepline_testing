{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Push Watcher",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-NoProfile",
                "-File", "${workspaceFolder}\\auto_push.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "showReuseMessage": false,
                "close": true
            }
        }
    ]
}
